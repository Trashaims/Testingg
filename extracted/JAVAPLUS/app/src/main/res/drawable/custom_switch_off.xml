<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Track -->
    <item android:gravity="center_vertical">
        <shape android:shape="rectangle">
            <solid android:color="#3A434F"/>
            <corners android:radius="10dp"/>
            <size android:width="38dp" android:height="20dp"/>
        </shape>
    </item>
    <!-- Thumb -->
    <item android:gravity="center_vertical|start" android:left="3dp">
        <shape android:shape="oval">
            <solid android:color="@color/text_dim"/>
            <size android:width="14dp" android:height="14dp"/>
        </shape>
    </item>
</layer-list>
